# ==============================================================================
# VoyagePilot AI Backend Environment Variables Template
# Copy this file to backend/.env or configure via container/cloud environment
# NEVER commit production credentials or API keys to version control.
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (MySQL 8.0+)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/voyagepilot_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=voyagepilot_user
SPRING_DATASOURCE_PASSWORD=YourSecureDatabasePassword123!

# JWT Authentication
# IMPORTANT: Generate a cryptographically secure 256-bit (32+ chars) hex/base64 secret for production!
JWT_SECRET=voyagepilot_production_jwt_secret_key_minimum_256_bits_for_hmac_sha256_security
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.voyagepilot.ai

# AI Disruption & Recommendation Engine (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Email Notification Service (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=notifications@voyagepilot.ai
SPRING_MAIL_PASSWORD=your_smtp_app_password_here
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
